// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             Int       @id @default(autoincrement())
  email          String    @unique @db.VarChar(255)
  firstName      String    @map("first_name") @db.VarChar(255)
  lastName       String    @map("last_name") @db.VarChar(255)
  hashedPassword String    @map("hashed_password") @db.VarChar(60)

  accounts Account[]

  @@map("user")
}

model Account {
  id              Int     @id @default(autoincrement())
  userId          Int     @map("u_id")
  plaidAccountId  String  @unique @map("plaid_account_id") @db.VarChar(100)
  name            String  @db.VarChar(255)
  institution     String  @db.VarChar(255)
  category        String  @db.VarChar(60)
  mask            String? @db.VarChar(10)
  balance         Decimal @db.Decimal(12, 2)

  user         User          @relation(fields: [userId], references: [id])
  transactions Transaction[]

  @@map("account")
}

model Transaction {
  id                 Int      @id @default(autoincrement())
  accountId          Int      @map("account_id")
  plaidTransactionId String   @unique @map("plaid_transaction_id") @db.VarChar(100)
  name               String   @db.VarChar(255)
  merchantName       String?  @map("merchant_name") @db.VarChar(255)
  amount             Decimal  @db.Decimal(12, 2)
  currency           String   @db.VarChar(10)
  date               DateTime @db.Date

  account Account @relation(fields: [accountId], references: [id])

  @@map("transaction")
}
